# npm run db:setup creates a local generated credential in .env.local.
# Configure a dedicated PostgreSQL database for deployed environments.
DATABASE_URL=
# Deployed HTTPS canonical origin, required behind a reverse proxy:
# APP_ORIGIN=https://your-domain.example
# Python interpreter containing the pinned solver:
# FARM_PYTHON=/workspace/.farmstead-venv/bin/python
# Run migrations with a separately supplied MIGRATION_DATABASE_URL.
# Never expose administrative credentials through NEXT_PUBLIC_ variables.
