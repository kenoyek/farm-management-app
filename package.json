{
  "name": "farmstead",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  }
}
